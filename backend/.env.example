# Copy this file to .env and adjust as needed. start.sh does this automatically.
#
# This is the ONE .env for the whole project: [A]'s banking backend and
# [B]'s AI layer (app/ai) both read it through app/config.py::Settings.
# .env is gitignored - never commit real values.

ENV=development

# Supabase - Project Settings > API. No direct Postgres connection is used
# anywhere in this app (the corporate network this was built on blocks
# outbound 5432/6543 - only 443/HTTPS is open, which is all PostgREST needs).
# SUPABASE_KEY must be the "service_role"/"secret" key, NOT "anon"/
# "publishable": this backend is trusted server code, never exposed to a
# browser, and needs to bypass RLS. Schema/RPC functions live in
# backend/supabase/migrations/*.sql, applied manually via the Supabase SQL
# Editor (no local Postgres to run migrations against).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=service_role_key_aici

# Optional but strongly recommended: a SEPARATE Supabase project reserved
# for the test suite (backend/tests/conftest.py::clean_db wipes every row
# in every table before each test - this already wiped the dev project once
# because no separate test project existed yet). Same schema as the dev
# project (run every backend/supabase/migrations/*.sql file against it
# too), different project so pytest can never touch real data. Leave both
# unset and the test suite falls back to SUPABASE_URL/SUPABASE_KEY above,
# but then requires ALLOW_TEST_DB_WIPE=1 as an explicit "yes, I understand"
# before it will wipe that project.
TEST_SUPABASE_URL=
TEST_SUPABASE_KEY=

# Session cookie (server-side sessions; the cookie only carries an opaque
# token, see app/core/security.py + app/core/dependencies.py).
SESSION_COOKIE_NAME=session_token
SESSION_TTL_SECONDS=604800

# JSON array of allowed origins for the frontend. Must list every origin
# that calls this API with credentials (cookies) included - :5000 is the
# frontend/ Flask app's dev port, :8080 is the static frontend/index.html
# prototype served via `python -m http.server 8080` (see frontend/README.md),
# :3000 is a placeholder for a JS-framework dev server if that replaces them.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5000","http://localhost:8080"]

# Simple in-process rate limit (requests/minute/client-ip). Not distributed.
# NOTE: this counter lives in one process's memory, so with more than one
# backend replica the effective limit multiplies by the replica count.
RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# vision-service (see vision/ and app/core/vision_client.py)
# ---------------------------------------------------------------------------
# OCR (ID cards, IBANs), PDF text extraction and face embeddings run in a
# separate container so this image doesn't need tesseract or a C++ toolchain.
# Under docker compose both values are set for you (see docker-compose.yml) -
# these only matter when running the backend outside compose.
VISION_SERVICE_URL=http://vision:8100
# Shared secret; must match VISION_SERVICE_TOKEN in the vision container.
# The vision service refuses every request when it is unset, rather than
# failing open.
VISION_SERVICE_TOKEN=dev-vision-token

# ---------------------------------------------------------------------------
# e-Sign (see app/modules/esign) - Ed25519 detached signatures over
# uploaded documents. Generate a dev key with:
#   python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Signing fails closed (503 esign_unavailable) while this is unset.
# ---------------------------------------------------------------------------
ESIGN_PRIVATE_KEY=
ESIGN_KEY_ID=esign-dev-1

# ---------------------------------------------------------------------------
# Azure AI Speech (see app/modules/speech) - text-to-speech for the chat
# "read aloud" button. A separate Azure resource from Azure OpenAI above.
# Fails closed (503 speech_service_unavailable) while this is unset - the
# frontend falls back to the browser's own (much more limited) built-in
# voices in that case.
# ---------------------------------------------------------------------------
# A bare region name (e.g. "westeurope", not a full URL) - used to build
# the standard regional endpoint. Either this or AZURE_SPEECH_ENDPOINT is
# required; this one wins if both are set, because the Speech synthesize
# call needs it specifically - unlike most Cognitive Services APIs, it
# 404s against a resource's own custom-domain endpoint (confirmed against
# a real Azure AI Foundry Speech resource: same key, only the regional
# host worked).
AZURE_SPEECH_REGION=
# Full resource endpoint, e.g. https://<resource>.cognitiveservices.azure.com
# Only used when AZURE_SPEECH_REGION is unset.
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
# Must be a "Multilingual" neural voice (Azure names these explicitly, e.g.
# ending in "MultilingualNeural") - that's what lets one voice read every
# language the app supports fluently, switching language per request via
# SSML rather than needing a different voice picked per language.
AZURE_SPEECH_VOICE=en-US-AndrewMultilingualNeural
# Fallback SSML language when a request doesn't name one.
AZURE_SPEECH_LANGUAGE=en-US

# Password reset OTP delivery, via a Microsoft Teams webhook. In Teams:
# channel > Workflows > "Send webhook alerts to a chat" template > pick/create
# a chat > copy the generated URL. Leave unset in dev to skip delivery (the
# code is still generated/stored, it just never reaches anyone - check
# password_reset_codes directly instead).
TEAMS_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# AI layer (app/ai) - Azure OpenAI / Azure AI Foundry
# ---------------------------------------------------------------------------
# Which provider the AI layer should use. Valid values:
#   mock   - offline canned reply; needs none of the AZURE_* values below.
#            POST /api/v1/chat works out of the box with this.
#   azure  - the real model, via the AZURE_OPENAI_* values below. If any of
#            them are missing, /api/v1/chat returns 503.
# Anything else is a configuration error and /api/v1/chat returns 500.
AI_PROVIDER=mock

# Resource host. An Azure AI Foundry inference endpoint ending in "/models"
# is also accepted - app/config.py normalises it to the resource root.
#   e.g. https://<your-resource>.openai.azure.com
#   e.g. https://<your-resource>.services.ai.azure.com
AZURE_OPENAI_ENDPOINT=

# API key for the resource above.
AZURE_OPENAI_API_KEY=

# Optional. Defaults to a version new enough for the gpt-5 family + tool calling.
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# The DEPLOYMENT name in Azure (not the base model string), e.g. gpt-5-mini.
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# Azure AI Foundry naming is accepted as a fallback when the canonical
# AZURE_OPENAI_* names above are absent:
#   AZURE_AI_ENDPOINT, AZURE_AI_API_KEY, AZURE_AI_API_VERSION,
#   AZURE_AI_CHAT_DEPLOYMENT

# Embedding deployment for the docs agent's RAG search (app/ai/knowledge).
# Same endpoint/key as above, different deployment - an embedding model
# (e.g. text-embedding-3-small), not a chat model. Only needed for the
# "azure" provider; unused by mock. Deployment must produce 1536-dim vectors
# to match the `VECTOR(1536)` column in
# supabase/migrations/0013_knowledge_base.sql.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---------------------------------------------------------------------------
# Azure AI Document Intelligence - used ONLY by
# scripts/ingest_knowledge_base.py, never on the request path. A separate
# Azure resource from Azure OpenAI above (Project Settings > Keys and
# Endpoint on the Document Intelligence resource).
# ---------------------------------------------------------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
